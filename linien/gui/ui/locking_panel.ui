           <widget class="QPushButton" name="selectLineToWavemeterLock">
            <property name="minimumSize">
             <size><width>0</width><height>50</height></size>
            </property>
            <property name="font">
             <font><weight>75</weight><bold>true</bold></font>
            </property>
            <property name="styleSheet">
             <string notr="true">background: #00aa00</string>
            </property>
            <property name="text">
             <string>Select wavemeter lock target line</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QFormLayout" name="formLayout_wavemeter">
        <item row="0" column="0">
         <widget class="QLabel" name="label_wm_url">
          <property name="text"><string>Wavemeter address</string></property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="wavemeter_url">
          <property name="placeholderText"><string>http://192.168.0.119:8050</string></property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_wm_setpoint">
          <property name="text"><string>Raw setpoint (GHz)</string></property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_setpoint">
          <property name="decimals"><number>4</number></property>
          <property name="minimum"><double>0.000000</double></property>
          <property name="maximum"><double>10000000.000000</double></property>
          <property name="singleStep"><double>0.001000</double></property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_wm_range">
          <property name="text"><string>Engage TTL low within (MHz)</string></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_range">
          <property name="decimals"><number>1</number></property>
          <property name="minimum"><double>0.000000</double></property>
          <property name="maximum"><double>1000000.000000</double></property>
          <property name="singleStep"><double>10.000000</double></property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="label_wm_search">
          <property name="text"><string>Search for the laser within (GHz)</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_search_range">
          <property name="decimals"><number>3</number></property>
          <property name="minimum"><double>0.001000</double></property>
          <property name="maximum"><double>1000.000000</double></property>
          <property name="singleStep"><double>1.000000</double></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="label_wm_handoff">
          <property name="text"><string>Hand over to line search within (MHz)</string></property>
         </widget>
        </item>
        <item row="4" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_handoff_window">
          <property name="decimals"><number>1</number></property>
          <property name="minimum"><double>1.000000</double></property>
          <property name="maximum"><double>100000.000000</double></property>
          <property name="singleStep"><double>10.000000</double></property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="label_wm_min_amp">
          <property name="text"><string>Discard readings dimmer than</string></property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_min_amp">
          <property name="decimals"><number>3</number></property>
          <property name="minimum"><double>0.000000</double></property>
          <property name="maximum"><double>1.000000</double></property>
          <property name="singleStep"><double>0.005000</double></property>
         </widget>
        </item>
        <item row="6" column="0">
         <widget class="QLabel" name="label_wm_poll">
          <property name="text"><string>Poll interval (s)</string></property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_poll_interval">
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.050000</double></property>
          <property name="maximum"><double>60.000000</double></property>
          <property name="singleStep"><double>0.100000</double></property>
         </widget>
        </item>
        <item row="7" column="0">
         <widget class="QLabel" name="label_wm_count">
          <property name="text"><string>Readings out of range before relocking</string></property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="QSpinBox" name="wavemeter_max_out_of_range">
          <property name="minimum"><number>1</number></property>
          <property name="maximum"><number>1000</number></property>
         </widget>
        </item>
        <item row="8" column="0">
         <widget class="QLabel" name="label_wm_steer_amp">
          <property name="text"><string>Scan amplitude while steering (V)</string></property>
         </widget>
        </item>
        <item row="8" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_steering_ramp_amplitude">
          <property name="decimals"><number>3</number></property>
          <property name="minimum"><double>0.001000</double></property>
          <property name="maximum"><double>1.000000</double></property>
          <property name="singleStep"><double>0.010000</double></property>
         </widget>
        </item>
        <item row="9" column="0">
         <widget class="QLabel" name="label_wm_lock_settle">
          <property name="text"><string>Give the lockbox to capture (s)</string></property>
         </widget>
        </item>
        <item row="9" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_lock_settle_time">
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.000000</double></property>
          <property name="maximum"><double>60.000000</double></property>
          <property name="singleStep"><double>0.500000</double></property>
         </widget>
        </item>
        <item row="10" column="0">
         <widget class="QLabel" name="label_wm_settle">
          <property name="text"><string>Settle time after tuning (s)</string></property>
         </widget>
        </item>
        <item row="10" column="1">
         <widget class="QDoubleSpinBox" name="wavemeter_settle_time">
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.000000</double></property>
          <property name="maximum"><double>30.000000</double></property>
          <property name="singleStep"><double>0.100000</double></property>
         </widget>
        </item>
           </layout>
          </item>
         <item>
          <widget class="QCheckBox" name="wavemeter_skip_line_search_checkbox">
           <property name="text"><string>Engage as soon as the wavemeter settles (skip the line search)</string></property>
           <property name="checked"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="wavemeter_use_raw_checkbox">
           <property name="text"><string>Use uncalibrated frequencies (required when locking the wavemeter\u2019s own calibration laser)</string></property>
           <property name="checked"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="watch_wavemeter_checkbox">
           <property name="text"><string>Relock automatically when the frequency leaves the window</string></property>
           <property name="checked"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="autoOffsetCheckbox_wavemeter">
